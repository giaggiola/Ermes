# Run node scripts/setup.mjs to create .env with random deployment keys.
# Store details and Resend/Shopify credentials are entered in the setup UI.
APP_URL=http://localhost:3025
ERMES_PORT=3025
POSTGRES_PASSWORD=
ERMES_ENCRYPTION_KEY=
# Optional: require a key when creating the first owner account.
ERMES_SETUP_TOKEN=
OPS_MESSAGING_SHARED_SECRET=
COMMERCE_EVENT_WEBHOOK_SECRET=
PREFERENCE_TOKEN_SECRET=
